2","cwe":"CWE-436","source":"ce714d77-add3-4f53-aff5-83d477b104bb","type":"Secondary"}],"fix":{"versions":["3.1.2"],"state":"fixed","available":[{"version":"3.1.2","date":"2026-05-09","kind":"first-observed"}]},"advisories":[],"risk":0.00825},"relatedVulnerabilities":[{"id":"CVE-2026-6322","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-6322","namespace":"nvd:cpe","severity":"High","urls":["https://cna.openjsf.org/security-advisories.html","https://github.com/fastify/fast-uri/security/advisories/GHSA-v39h-62p7-jpjc"],"description":"fast-uri normalize() decoded percent-encoded authority delimiters inside the host component and then re-emitted them as raw delimiters during serialization. A host that combined an allowed domain, an encoded at-sign, and a different domain was re-emitted with the at-sign as a raw userinfo separator, changing the URI's authority to the second domain. Applications that normalize untrusted URLs before host allowlist checks, redirect validation, or outbound request routing can be steered to a different authority than the input appeared to specify. Versions <= 3.1.1 are affected. Update to 3.1.2 or later.","cvss":[{"source":"ce714d77-add3-4f53-aff5-83d477b104bb","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-6322","epss":0.00011,"percentile":0.01543,"date":"2026-05-28"}],"cwes":[{"cve":"CVE-2026-6322","cwe":"CWE-436","source":"ce714d77-add3-4f53-aff5-83d477b104bb","type":"Secondary"}]}],"matchDetails":[{"type":"exact-direct-match","matcher":"javascript-matcher","searchedBy":{"language":"javascript","namespace":"github:language:javascript","package":{"name":"fast-uri","version":"3.1.0"}},"found":{"vulnerabilityID":"GHSA-v39h-62p7-jpjc","versionConstraint":"<=3.1.1 (semantic)"},"fix":{"suggestedVersion":"3.1.2"}}],"artifact":{"id":"e9e9826caa72582a","name":"fast-uri","version":