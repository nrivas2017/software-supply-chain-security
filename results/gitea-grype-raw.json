{"matches":[{"vulnerability":{"id":"GHSA-q3j6-qgpj-74h6","dataSource":"https://github.com/advisories/GHSA-q3j6-qgpj-74h6","namespace":"github:language:javascript","severity":"High","urls":["https://github.com/fastify/fast-uri/security/advisories/GHSA-q3j6-qgpj-74h6","https://nvd.nist.gov/vuln/detail/CVE-2026-6321","https://cna.openjsf.org/security-advisories.html"],"description":"fast-uri vulnerable to path traversal via percent-encoded dot segments","cvss":[{"type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:N/I:H/A:N","metrics":{"baseScore":7.5,"exploitabilityScore":3.9,"impactScore":3.6},"vendorMetadata":{}}],"epss":[{"cve":"CVE-2026-6321","epss":0.00053,"percentile":0.16888,"date":"2026-06-06"}],"cwes":[{"cve":"CVE-2026-6321","cwe":"CWE-22","source":"ce714d77-add3-4f53-aff5-83d477b104bb","type":"Secondary"}],"fix":{"versions":["3.1.1"],"state":"fixed","available":[{"version":"3.1.1","date":"2026-05-09","kind":"first-observed"}]},"advisories":[],"risk":0.039749999999999994},"relatedVulnerabilities":[{"id":"CVE-2026-6321","dataSource":"https://nvd.nist.gov/vuln/detail/CVE-2026-6321","namespace":"nvd:cpe","severity":"High","urls":["https://cna.openjsf.org/security-advisories.html","https://github.com/fastify/fast-uri/security/advisories/GHSA-q3j6-qgpj-74h6"],"description":"fast-uri decoded percent-encoded path separators and dot segments before applying dot-segment removal in its normalize() and equal() functions. Encoded path data was treated like real slashes and parent-directory references, so distinct URIs could collapse onto the same normalized path. Applications that normalize or compare attacker-controlled URLs to enforce path-based policy can be bypassed, with a path that appears confined under an allowed prefix normalizing to a different location. Versions <= 3.1.0 are affected. Update to 3.1.1 or later.","cvss":[{"source":"ce714d77-add3-4f53-aff5-83d477b104bb","type":"Secondary","version":"3.1","vector":"CVSS:3.1/AV:N/AC:L/PR: